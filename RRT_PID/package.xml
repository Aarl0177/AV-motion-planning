<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>av_rrt_pid</name>
  <version>0.1.0</version>
  <description>
    RRT motion planning and PID path following for a kinematic-bicycle car
    among moving obstacles, simulated in Gazebo Harmonic with ROS 2 Humble.
    C++ port of the CasADi NMPC obstacle-avoidance script.
  </description>
  <maintainer email="tshetabi2@huskers.unl.edu">Tina</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
