<?xml version="1.0"?>
<!-- Generated by make_world from config/params.yaml. -->
<sdf version="1.9">
  <world name="av_rrt_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- The car and the obstacles are velocity-controlled kinematic bodies
         (like the MuJoCo replay, where the bicycle model set the body pose).
         With gravity on they would slowly sink between velocity updates. -->
    <gravity>0 0 0</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.80 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>80 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>80 20</size></plane></geometry>
          <material><ambient>0.28 0.28 0.28 1</ambient><diffuse>0.28 0.28 0.28 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Reference lane y = 2 (visual only) -->
    <model name="reference_lane">
      <static>true</static>
      <pose>12.5 2 0.005 0 0 0</pose>
      <link name="link">
        <visual name="lane">
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>50 0.05 0.01</size></box></geometry>
          <material><ambient>0.1 0.8 0.1 1</ambient><diffuse>0.1 0.8 0.1 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
          <transparency>0</transparency>
        </visual>
      </link>
    </model>

    <!-- Goal marker (visual only) -->
    <model name="goal_marker">
      <static>true</static>
      <pose>25 2 0.01 0 0 0</pose>
      <link name="link">
        <visual name="goal">
          <pose>0 0 0 0 0 0</pose>
          <geometry><cylinder><radius>0.5</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.1 0.9 0.2 1</ambient><diffuse>0.1 0.9 0.2 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
          <transparency>0.5</transparency>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>
    </model>

    <model name="car">
      <pose>0 0 0.13 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>10.0</mass>
          <inertia><ixx>0.15</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.45</iyy><iyz>0</iyz><izz>0.5</izz></inertia>
        </inertial>
        <collision name="chassis_collision">
          <geometry><box><size>0.7 0.36 0.16</size></box></geometry>
        </collision>
        <visual name="chassis">
          <pose>0 0 0 0 0 0</pose>
          <geometry><box><size>0.7 0.36 0.16</size></box></geometry>
          <material><ambient>0.1 0.25 0.9 1</ambient><diffuse>0.1 0.25 0.9 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
          <transparency>0</transparency>
        </visual>
        <visual name="hood">
          <pose>0.22 0 0.03 0 0 0</pose>
          <geometry><box><size>0.24 0.30 0.10</size></box></geometry>
          <material><ambient>0.2 0.48 1 1</ambient><diffuse>0.2 0.48 1 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
          <transparency>0</transparency>
        </visual>
        <visual name="cabin">
          <pose>-0.06 0 0.11 0 0 0</pose>
          <geometry><box><size>0.28 0.26 0.14</size></box></geometry>
          <material><ambient>0.03 0.05 0.12 1</ambient><diffuse>0.03 0.05 0.12 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
          <transparency>0</transparency>
        </visual>
        <visual name="lidar_sensor">
          <pose>0.38 0 0.08 0 0 0</pose>
          <geometry><box><size>0.05 0.10 0.05</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
          <transparency>0</transparency>
        </visual>
        <visual name="lidar_left_beam">
          <pose>1.795 0.41 0.08 0 1.5708 0.270763</pose>
          <geometry><cylinder><radius>0.012</radius><length>2.91625</length></cylinder></geometry>
          <material><ambient>0.1 0.8 1 1</ambient><diffuse>0.1 0.8 1 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
          <transparency>0.65</transparency>
          <cast_shadows>false</cast_shadows>
        </visual>
        <visual name="lidar_right_beam">
          <pose>1.795 -0.41 0.08 0 1.5708 -0.270763</pose>
          <geometry><cylinder><radius>0.012</radius><length>2.91625</length></cylinder></geometry>
          <material><ambient>0.1 0.8 1 1</ambient><diffuse>0.1 0.8 1 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
          <transparency>0.65</transparency>
          <cast_shadows>false</cast_shadows>
        </visual>
        <visual name="front_left_wheel">
          <pose>0.23 0.21 -0.07 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.055</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.01 0.01 0.01 1</ambient><diffuse>0.01 0.01 0.01 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
          <transparency>0</transparency>
          <cast_shadows>true</cast_shadows>
        </visual>
        <visual name="front_right_wheel">
          <pose>0.23 -0.21 -0.07 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.055</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.01 0.01 0.01 1</ambient><diffuse>0.01 0.01 0.01 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
          <transparency>0</transparency>
          <cast_shadows>true</cast_shadows>
        </visual>
        <visual name="rear_left_wheel">
          <pose>-0.23 0.21 -0.07 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.055</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.01 0.01 0.01 1</ambient><diffuse>0.01 0.01 0.01 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
          <transparency>0</transparency>
          <cast_shadows>true</cast_shadows>
        </visual>
        <visual name="rear_right_wheel">
          <pose>-0.23 -0.21 -0.07 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.055</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.01 0.01 0.01 1</ambient><diffuse>0.01 0.01 0.01 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
          <transparency>0</transparency>
          <cast_shadows>true</cast_shadows>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system"
              name="gz::sim::systems::VelocityControl"/>
      <plugin filename="gz-sim-odometry-publisher-system"
              name="gz::sim::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>car</robot_base_frame>
        <odom_publish_frequency>50</odom_publish_frequency>
        <dimensions>2</dimensions>
      </plugin>
    </model>

    <model name="obs_0">
      <pose>3 1.5 0.31 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>5</mass>
          <inertia><ixx>0.18</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.18</iyy><iyz>0</iyz><izz>0.18</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
        <visual name="safe_zone">
          <pose>0 0 -0.295 0 0 0</pose>
          <geometry><cylinder><radius>0.9</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
          <transparency>0.82</transparency>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system"
              name="gz::sim::systems::VelocityControl"/>
      <plugin filename="gz-sim-odometry-publisher-system"
              name="gz::sim::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>obs_0</robot_base_frame>
        <odom_publish_frequency>50</odom_publish_frequency>
        <dimensions>2</dimensions>
      </plugin>
    </model>

    <model name="obs_1">
      <pose>10 2.65 0.31 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>5</mass>
          <inertia><ixx>0.18</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.18</iyy><iyz>0</iyz><izz>0.18</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
        </collision>
        <visual name="visual">
