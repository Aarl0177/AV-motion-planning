    <model name="obs_2">
      <pose>20 1.65 0.31 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>5</mass>
          <inertia><ixx>0.18</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.18</iyy><iyz>0</iyz><izz>0.18</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.3</radius></sphere></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
        </visual>
        <visual name="safe_zone">
          <pose>0 0 -0.295 0 0 0</pose>
          <geometry><cylinder><radius>0.9</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse><specular>0.1 0.1 0.1 1</specular></material>
          <transparency>0.82</transparency>
          <cast_shadows>false</cast_shadows>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system"
