<!--
  Gazebo Harmonic + ros_gz_bridge + the three C++ nodes (+ RViz).

    ros2 launch av_rrt_pid sim.launch.xml
    ros2 launch av_rrt_pid sim.launch.xml rviz:=false

  After changing obstacles, lane, goal or start pose in params.yaml, run the
  make_world tool and pass its output files as world:= and bridge_config:=
  (exact commands in the README, section "Changing the scenario").

  ROS 2 launch files can be Python, XML or YAML, not C++. This one is XML.
-->
<launch>
  <arg name="params" default="$(find-pkg-share av_rrt_pid)/config/params.yaml"
       description="Parameter file for the nodes"/>
  <arg name="world" default="$(find-pkg-share av_rrt_pid)/worlds/av_rrt_world.sdf"
       description="Gazebo world (generated by make_world)"/>
  <arg name="bridge_config" default="$(find-pkg-share av_rrt_pid)/config/bridge.yaml"
       description="ros_gz_bridge topics (generated by make_world)"/>
  <arg name="rviz" default="true" description="Start RViz with the planner view"/>
  <arg name="paused" default="true"
       description="Start Gazebo paused; press Play (bottom-left) once the window is up"/>

  <!-- Gazebo Harmonic. Paused by default: on slow machines (e.g. WSL) the
       window can take many seconds to open, and a running simulation would
       finish before you see it. Everything uses sim time, so the nodes simply
       wait until you press Play. paused:=false starts it immediately (-r). -->
  <executable cmd="gz sim $(var world)" output="screen" if="$(var paused)"/>
  <executable cmd="gz sim -r $(var world)" output="screen" unless="$(var paused)"/>

  <!-- ROS <-> Gazebo topics: /clock, the car and every obstacle -->
  <node pkg="ros_gz_bridge" exec="parameter_bridge" name="gz_bridge" output="screen">
    <param name="config_file" value="$(var bridge_config)"/>
  </node>

  <node pkg="av_rrt_pid" exec="obstacle_manager_node" name="obstacle_manager" output="screen">
    <param from="$(var params)"/>
  </node>

  <node pkg="av_rrt_pid" exec="rrt_planner_node" name="rrt_planner" output="screen">
    <param from="$(var params)"/>
  </node>

  <node pkg="av_rrt_pid" exec="pid_controller_node" name="pid_controller" output="screen">
    <param from="$(var params)"/>
  </node>

  <node pkg="rviz2" exec="rviz2" name="rviz2" output="log"
        args="-d $(find-pkg-share av_rrt_pid)/rviz/av_rrt_pid.rviz" if="$(var rviz)">
    <param name="use_sim_time" value="true"/>
  </node>
</launch>
